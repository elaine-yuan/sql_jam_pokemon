-- ============================================================
-- SELECT BASICS
-- ============================================================

-- https://sqljam.dev/?skin=pokemon&challenge=pokemon-select-name-type
-- Difficulty: Easy
-- Challenge: Return just the `name` and `primary_type` columns for every Pokémon.
-- My Solution:
SELECT name, primary_type
FROM pokemon;

-- ------------------------------------------------------------

-- https://sqljam.dev/?skin=pokemon&challenge=pokemon-select-stat-columns
-- Difficulty: Easy
-- Challenge: How many different types are there? List each distinct `primary_type` in the `pokemon` table — one row per type, no repeats.
-- My Solution:
SELECT DISTINCT primary_type
FROM pokemon;

-- ------------------------------------------------------------

-- https://sqljam.dev/?skin=pokemon&challenge=pokemon-select-aliases
-- Difficulty: Easy
-- Challenge: Rename the columns in your output: return `name` as `pokemon`, `primary_type` as `type` and `total_stats` as `power`.
-- My Solution:
SELECT name AS pokemon, primary_type AS type, total_stats AS power
FROM pokemon;

-- ------------------------------------------------------------

-- https://sqljam.dev/?skin=pokemon&challenge=pokemon-select-type-label
-- Difficulty: Medium
-- Challenge: Build a display label for the strongest dual-type Legendaries. For every Legendary with a `secondary_type` and `total_stats` of at least 600, return a single column `label` reading like `Rayquaza (dragon/flying)`, plus `total_stats`.
-- My Solution:
SELECT name||' ('||primary_type||'/'||secondary_type||')' AS label, total_stats
FROM pokemon
WHERE is_legendary=TRUE AND secondary_type IS NOT NULL AND total_stats>=600;
